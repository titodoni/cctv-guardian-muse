# --- EZVIZ account ---
EZVIZ_EMAIL=you@example.com
EZVIZ_PASSWORD=
# Region endpoint. Common values:
#   apiisgp.ezvizlife.com  (Asia-Pacific, default)
#   apiieu.ezvizlife.com   (Europe)
#   apius.ezvizlife.com    (Americas)
EZVIZ_REGION=apiisgp.ezvizlife.com
# One-time MFA code — only set this when EZVIZ asks for verification.
# EZVIZ removes it after use; never store a code permanently.
# EZVIZ_MFA=123456

# --- Cameras ---
# Register cameras in cameras.json (see cameras.example.json).
# Find each camera's serial in the EZVIZ app: device Settings > Device Information.

# --- Notifications (optional) ---
# Generic webhook receiving POST JSON:
#   {"text","camera","camera_name","alarm_time","is_night","image_path"}
# Point it at your own bot/service (WhatsApp bridge, Telegram bot, n8n, ...).
# When unset, guardian_check.py prints alerts to stdout (captured by the cron log).
# NOTIFY_WEBHOOK=https://your-server.example.com/hook/cctv

# --- Vision descriptions (optional) ---
# Any OpenAI-compatible chat-completions endpoint that accepts image_url.
# When unset, alerts use a plain "Motion detected." message.
# VISION_API_URL=https://api.example.com/v1
# VISION_API_KEY=
# VISION_MODEL=
# VISION_LANG=en   # en | id | fr

# --- Guardian ---
# Max alerts per camera per cron run (spam guard).
GUARDIAN_MAX_ALERTS=3

# --- Advanced ---
# Override the config directory (default: ~/.cctv-guardian).
# CCTV_GUARDIAN_HOME=/path/to/config
